# syntax=docker/dockerfile:1
# LouisNet 单Reactor压测镜像（v1.2.0 + bugfix cherry-pick，FetchContent构建）
# 推荐用 bash benchmark/docker/build_all.sh 统一构建；手动构建（仓库根目录执行）:
#   docker build -f benchmark/docker/Dockerfile.single \
#     --build-arg GIT_SHA=$(git -C .worktrees/single-reactor rev-parse --short HEAD) \
#     -t louisnet:bench-single .worktrees/single-reactor
ARG GIT_SHA=unknown

FROM ubuntu:24.04
ARG GIT_SHA

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git python3-pip curl iproute2 unzip \
    && rm -rf /var/lib/apt/lists/*

# wrk 从源码构建
RUN git clone --depth 1 https://github.com/wg/wrk.git /tmp/wrk \
    && make -C /tmp/wrk -j"$(nproc)" \
    && cp /tmp/wrk/wrk /usr/local/bin/

WORKDIR /src
COPY . .

# Release 选项对齐 Conan（-O3 -DNDEBUG）
RUN cmake --preset release -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_CXX_FLAGS="-Wall -Wextra -O3 -DNDEBUG" \
    && cmake --build --preset release -j"$(nproc)"

# 压测脚本直接取自本分支的 benchmark/scripts（三分支脚本已对齐）
COPY benchmark/scripts/scenario_*.sh benchmark/scripts/benchmark_common.sh \
     benchmark/scripts/pipeline.lua /opt/bench/
RUN chmod +x /opt/bench/*.sh && echo "${GIT_SHA}" > /opt/bench/GIT_SHA

WORKDIR /opt/bench
CMD ["/bin/bash"]
